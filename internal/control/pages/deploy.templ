package pages

import (
	"strconv"
	"strings"

	"github.com/Cidan/ok/internal/web/layout"
	"github.com/Cidan/ok/internal/web/nav"
)

// clDeploysRegion is the Deployments tab: a merged CL's deployments, newest first, each linked
// to its page. A live region: it refreshes itself until every deployment of the change has been
// planned and has finished.
templ clDeploysRegion(d CLDeploys) {
	<div
		id="cl-deploys"
		data-live
		if d.Live() {
			hx-get={ d.Href }
			hx-trigger="live"
			data-live-events={ d.ChangeEvents }
			hx-target="this"
			hx-swap="outerHTML"
		}
	>
		@panel() {
			@panelHead() {
				<h3>Deployments</h3>
				<span class="flex-1"></span>
				if len(d.Items) > 0 {
					<span class="text-subtle">{ strconv.Itoa(len(d.Items)) }</span>
				}
			}
			switch  {
				case !d.Landed:
					@panelEmpty() {
						Deployments begin once the change lands.
					}
				case d.Error != "":
					@panelEmpty() {
						{ d.Error }
					}
				case len(d.Items) == 0 && !d.Planned:
					@panelEmpty() {
						The deployer has not planned this change yet.
					}
				case len(d.Items) == 0:
					@panelEmpty() {
						Nothing it changed is deployed.
					}
				default:
					for _, it := range d.Items {
						@clDeploymentRow(it)
					}
			}
		}
	</div>
}

// clDeploymentRow is one deployment: its status, the deploy and where a running one is, its
// workload, why it failed, and when.
templ clDeploymentRow(d CLDeployment) {
	<a href={ templ.SafeURL(d.Href) } hx-get={ d.Href } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class="flex items-start gap-3 border-b border-line-soft px-4 py-2.5 text-sm transition-colors last:border-b-0 hover:bg-hover">
		<span class="w-36 shrink-0">
			@chip(deployStatusTone(d.StatusKind)) {
				{ d.StatusLabel }
			}
		</span>
		<div class="min-w-0 flex-1 leading-6">
			<div class="flex min-w-0 items-center gap-2">
				<span class="truncate font-medium text-fg">{ d.Name }</span>
				if d.Workload != "" {
					<span class="truncate font-mono text-subtle">{ d.Workload }</span>
				}
			</div>
			if d.Stage != "" {
				<div class="text-muted">{ d.Stage }</div>
			}
			if d.Reason != "" {
				<div class="break-words text-muted">{ d.Reason }</div>
			}
		</div>
		<span class="shrink-0 whitespace-nowrap leading-6 text-faint" title={ d.AgeTitle }>{ d.Age }</span>
	</a>
}

// The deployment page — one deployment of a deploy (docs/deploy.md): what it deploys and
// why, where it stands, what it pushed and migrated, and its log. While it runs, its status
// panel and its log refresh themselves (docs/web.md, "Live regions").
templ DeploymentViewPage(n nav.Model, v DeploymentView) {
	@layout.Shell(shell(v.Name+" · Deployment "+strconv.FormatInt(v.ID, 10)+" · "+v.Chrome.Name+" · "+Brand, layout.TopNav, n)) {
		@DeploymentViewContent(v)
	}
}

templ DeploymentViewContent(v DeploymentView) {
	<div class="group/repo flex h-full flex-1 flex-col overflow-hidden">
		@repoHead(v.Chrome, tabChanges, "#repo-main", false)
		<div id="repo-main" data-hydrate class="hydrating flex-1 overflow-y-auto">
			@DeploymentViewMain(v)
		</div>
	</div>
}

templ DeploymentViewMain(v DeploymentView) {
	<div data-wide class="mx-auto w-full max-w-[100rem] px-6 pt-6 pb-16 sm:px-10 lg:px-12">
		<div class="mb-5 flex min-w-0 items-start gap-4">
			<div class="min-w-0 flex-1">
				<div class="flex items-center gap-2.5 text-sm">
					if v.CLHref != "" {
						<a href={ templ.SafeURL(v.CLHref) } hx-get={ v.CLHref } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class="text-accent-fg transition-colors hover:text-fg">CL #{ strconv.FormatInt(v.CLNumber, 10) }</a>
						<span class="text-faint">/</span>
					}
					<span class="font-mono text-subtle">Deployment { strconv.FormatInt(v.ID, 10) }</span>
				</div>
				<h2 class="mt-2 truncate font-mono text-xl font-semibold tracking-tight text-fg">{ v.Name }</h2>
			</div>
			<div class="flex shrink-0 items-center gap-2 pt-6">
				if v.AllowHref != "" {
					@clActionButton(v.AllowHref, "Allow Hazards", btnPrimary)
				}
				if v.RetryHref != "" {
					@clActionButton(v.RetryHref, "Retry", btnPrimary)
				}
				if v.HaltHref != "" {
					@clActionButton(v.HaltHref, "Halt", btnSecondary)
				}
			</div>
		</div>
		if v.Notice != "" {
			<div data-notice class="mb-4 flex items-start gap-2.5 rounded-xl border border-warn-line bg-warn-soft px-4 py-3 text-sm text-warn">
				@iconAlert()
				<span>{ v.Notice }</span>
			</div>
		}
		<div class="grid items-start gap-4 lg:grid-cols-3">
			<div class="space-y-4 lg:col-span-1">
				@deploymentStatus(v)
				@deploymentImages(v)
			</div>
			<div class="space-y-4 lg:col-span-2">
				@deploymentMigrations(v)
				@deploymentLog(v)
			</div>
		</div>
	</div>
}

// deploymentStatus is the deployment's status panel, a live region: while it runs it refreshes
// itself.
templ deploymentStatus(v DeploymentView) {
	<div
		id="deployment-status"
		data-live
		if v.Live {
			hx-get={ v.StatusHref }
			hx-trigger="live"
			data-live-events={ v.ChangeEvents }
			hx-target="this"
			hx-swap="outerHTML"
		}
	>
		@panel() {
			@panelHead() {
				<h3>Deployment</h3>
				<span class="flex-1"></span>
				@chip(deployStatusTone(v.StatusKind)) {
					{ v.StatusLabel }
				}
			}
			@panelBody() {
				<dl class="space-y-1.5 text-sm">
					@runInfoRow("Stage", v.Stage)
					@runInfoRow("Outcome", v.Reason)
					@runInfoRow("Roll", v.Roll)
					@runInfoRow("Workload", v.Workload)
					@clDeploymentCommitRow(v)
					@runInfoRow("Why", v.Why)
					@runInfoRow("Wave", v.Wave)
					@runInfoRow("Deploy", v.Deploy)
					@runInfoRow("Requested By", v.RequestedBy)
					@runInfoRow("Started", v.Started)
					@runInfoRow("Finished", v.Finished)
				</dl>
			}
		}
	</div>
}

templ clDeploymentCommitRow(v DeploymentView) {
	<div class="flex min-h-[1.625rem] items-center gap-3">
		<dt class="w-28 shrink-0 text-subtle">Commit</dt>
		<dd class="min-w-0 truncate">
			<a href={ templ.SafeURL(v.CommitHref) } hx-get={ v.CommitHref } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class="font-mono text-accent-fg transition-colors hover:text-fg">{ v.Commit }</a>
		</dd>
	</div>
}

templ deploymentImages(v DeploymentView) {
	@panel() {
		@panelTitle("Images")
		if len(v.Images) == 0 {
			@panelEmpty() {
				It only migrates.
			}
		} else {
			<div class="divide-y divide-line-soft">
				for _, im := range v.Images {
					<div class="px-4 py-3 text-sm">
						<div class="flex items-center gap-2">
							<span class="font-medium text-fg">{ im.Container }</span>
							<span class="flex-1"></span>
							if im.Run != 0 {
								<span class="font-mono text-subtle">Push Run { strconv.FormatInt(im.Run, 10) }</span>
							}
						</div>
						<div class="mt-0.5 truncate font-mono text-subtle">{ im.Target }</div>
						if im.Reference != "" {
							<div class="mt-0.5 break-all font-mono text-muted">{ im.Reference }</div>
						} else {
							<div class="mt-0.5 text-faint">Not pushed yet</div>
						}
					</div>
				}
			</div>
		}
	}
}

templ deploymentMigrations(v DeploymentView) {
	@panel() {
		@panelTitle("Migrations")
		if len(v.Migrations) == 0 {
			@panelEmpty() {
				No migrations.
			}
		} else {
			<div class="divide-y divide-line-soft">
				for _, m := range v.Migrations {
					@deploymentMigration(m)
				}
			</div>
		}
	}
}

templ deploymentMigration(m DeploymentMigration) {
	<div class="px-4 py-3 text-sm">
		<div class="flex items-center gap-2">
			<span class="min-w-0 flex-1 truncate font-mono text-fg">{ m.Target }</span>
			@chip(deployStatusTone(m.StatusKind)) {
				{ m.StatusLabel }
			}
		</div>
		if len(m.Refused) > 0 {
			<p class="mt-2 text-warn">Its plan carries gated hazards: { strings.Join(m.Refused, ", ") }. A repository admin allows them, and it applies again with them.</p>
		}
		if m.AllowedBy != "" {
			<p class="mt-2 text-muted">{ m.AllowedBy } allowed { strings.Join(m.Allowed, ", ") }.</p>
		}
		if len(m.Steps) > 0 {
			<ol class="mt-2 space-y-2">
				for i, st := range m.Steps {
					<li class="rounded-lg border border-line bg-sunken px-3 py-2">
						<div class="flex flex-wrap items-center gap-2">
							<span class="text-subtle">{ strconv.Itoa(i+1) }.</span>
							<span class="text-body">{ st.Description }</span>
							for _, h := range st.Hazards {
								if h.Gated {
									@chip(toneDanger) {
										{ h.Class }
									}
								} else {
									@chip(toneNeutral) {
										{ h.Class }
									}
								}
							}
						</div>
						<pre class="mt-1.5 overflow-x-auto whitespace-pre-wrap break-words font-mono text-[12.5px] leading-[1.6] text-muted">{ st.SQL }</pre>
					</li>
				}
			</ol>
		}
		if m.Output != "" {
			<details class="mt-2">
				<summary class="cursor-pointer text-subtle transition-colors hover:text-body">Output</summary>
				<pre class="mt-1.5 max-h-96 overflow-auto whitespace-pre-wrap break-words font-mono text-[12.5px] leading-[1.6] text-muted">{ m.Output }</pre>
			</details>
		}
	</div>
}

templ deploymentLog(v DeploymentView) {
	@panel() {
		@panelTitle("Log")
		if len(v.Events) == 0 {
			@panelEmpty() {
				Nothing yet.
			}
		} else {
			<ol class="divide-y divide-line-soft">
				for _, e := range v.Events {
					<li class="flex items-start gap-3 px-4 py-2 text-sm">
						<span class="min-w-28 shrink-0 whitespace-nowrap text-faint" title={ e.AtTitle }>{ e.At }</span>
						<span class="min-w-0 flex-1 break-words text-body">{ e.Message }</span>
					</li>
				}
			</ol>
		}
	}
}
