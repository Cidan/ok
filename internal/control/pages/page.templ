package pages

import (
	"strconv"

	"github.com/Cidan/ok/internal/web/infinitelist"
	"github.com/Cidan/ok/internal/web/layout"
	"github.com/Cidan/ok/internal/web/nav"
)

// HomePage is the full document for ok's home — the repo finder: every repository you can
// access, searchable, in a windowed infinite-scroll card. Rendered on a direct/deep-link GET;
// an htmx navigation gets HomeContent alone.
templ HomePage(n nav.Model, user, keyword string, page1 []RepoItem, url string, pageSize int, hasMore bool) {
	@layout.Shell(shell("Repositories · "+Brand, layout.LeftNav, n)) {
		@HomeContent(user, keyword, page1, url, pageSize, hasMore)
	}
}

// HomeContent is the swappable region: the shared PageHead, a search box + New repository
// button, and the repository list region (#repo-list). The search box is a livefilter input —
// it raw-fetches HomeList for the keyword and swaps it into #repo-list (no htmx, so the shell
// never fades and the input keeps focus while typing).
templ HomeContent(user, keyword string, page1 []RepoItem, url string, pageSize int, hasMore bool) {
	<div class="flex h-full flex-1 flex-col overflow-hidden">
		<div class="shrink-0">
			@PageHead("Repositories", "Every repository you can access.", "") {
				if user != "" {
					<span class="hidden text-sm text-zinc-500 sm:inline">Signed in as <span class="font-medium text-zinc-300">{ user }</span></span>
				}
			}
			<div class="mx-auto w-full max-w-5xl px-6 pb-5 sm:px-10">
				<div class="flex items-center gap-3">
					<div class="relative max-w-md flex-1">
						<span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-zinc-600">
							@iconSearch()
						</span>
						<input
							type="text"
							name="q"
							value={ keyword }
							placeholder="Search repositories…"
							autocomplete="off"
							data-filter
							data-filter-url="/repositories/list"
							data-filter-target="#repo-list"
							class="w-full rounded-lg border border-zinc-800 bg-zinc-900/50 py-2.5 pl-9 pr-4 text-sm text-zinc-100 placeholder:text-zinc-600 transition-colors focus:border-zinc-600 focus:outline-none"
						/>
					</div>
					<a href="/repositories/new" hx-get="/repositories/new" hx-target="#content" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class={ btnClass(btnInverse) }>New repository</a>
				</div>
			</div>
		</div>
		<div id="repo-list" class="flex flex-1 flex-col overflow-hidden">
			@HomeList(keyword, page1, url, pageSize, hasMore)
		</div>
	</div>
}

// HomeList is the repository list region — the windowed infinite-scroll card, or an empty state
// (distinguishing "no matches" for a search from "no repositories yet"). It is what the search
// box swaps into #repo-list, and what a direct GET renders inside HomeContent.
templ HomeList(keyword string, page1 []RepoItem, url string, pageSize int, hasMore bool) {
	if len(page1) == 0 {
		<div class="mx-auto w-full max-w-5xl px-6 sm:px-10">
			<div class="py-16 text-center text-sm">
				if keyword != "" {
					<div class="font-medium text-zinc-200">No Matches</div>
					<div class="mt-1.5 text-sm text-zinc-500">No repositories match “{ keyword }”.</div>
				} else {
					<div class="font-medium text-zinc-200">No Repositories Yet</div>
					<div class="mt-1.5 text-sm text-zinc-500">
						<a href="/repositories/new" hx-get="/repositories/new" hx-target="#content" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class="text-zinc-300 underline decoration-zinc-700 underline-offset-2 hover:decoration-zinc-400">Create your first repository</a>, or run <span class="font-mono text-zinc-400">jj create</span>.
					</div>
				}
			</div>
		</div>
	} else {
		@infinitelist.Scroller(url, pageSize, hasMore, "flex-1 pb-10", "mx-auto w-full max-w-5xl px-6 sm:px-10") {
			@RepoRows(page1)
		}
	}
}

// RepoRow is one repository row: a favorite (star) toggle, the name, and an inline meta line
// (its size and creator, and when main last moved). Flat — no box — separated from the next
// row by a hairline that fades out to the right. data-* attributes
// drive stars.js's optimistic toggle + FLIP reorder (favorites float to the top). The row is not
// a single <a> (the star button can't nest inside a link), so the text block is the link.
templ RepoRow(r RepoItem) {
	<div
		data-repo-row
		data-repo-link={ r.Link }
		data-starred={ boolAttr(r.Starred) }
		data-updated={ strconv.FormatInt(r.UpdatedUnix, 10) }
		class="group relative flex items-start gap-3 py-3.5 after:pointer-events-none after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-gradient-to-r after:from-zinc-700/60 after:via-zinc-800/30 after:to-transparent last:after:hidden"
	>
		<button
			type="button"
			data-star
			aria-pressed={ boolAttr(r.Starred) }
			aria-label="Toggle favorite"
			class="mt-0.5 shrink-0 rounded p-0.5 text-zinc-600 transition-colors hover:text-amber-400"
		>
			<span data-star-yes class={ "text-amber-400", templ.KV("hidden", !r.Starred) }>
				@iconStarFilled()
			</span>
			<span data-star-no class={ templ.KV("hidden", r.Starred) }>
				@iconStarOutline()
			</span>
		</button>
		<a href={ templ.SafeURL(r.Link) } hx-get={ r.Link } hx-target="#content" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class="block min-w-0 flex-1">
			<div class="flex items-center gap-2">
				<span class="truncate text-sm font-medium text-zinc-100 group-hover:text-white">{ r.Name }</span>
			</div>
			<div class="mt-1.5 flex items-center gap-2 text-sm text-zinc-600">
				if r.Detail != "" {
					<span class="truncate">{ r.Detail }</span>
				}
				if r.UpdatedAgo != "" {
					if r.Detail != "" {
						<span class="text-zinc-700">·</span>
					}
					<span title={ r.UpdatedTitle }>Updated { r.UpdatedAgo }</span>
				}
			</div>
		</a>
	</div>
}

// RepoRows renders a batch of repository rows — the initial page inside the Scroller and the
// per-page fragment the infinite-scroll controller fetches for ?page=N.
templ RepoRows(repos []RepoItem) {
	for _, r := range repos {
		@RepoRow(r)
	}
}

// NewRepoPage is the full document for the create-repository form; NewRepoContent is the
// swappable fragment served on an htmx navigation. The form posts a normal (non-htmx) POST
// so the server's 302 to the new repo is followed by the browser.
templ NewRepoPage(n nav.Model, f NewRepoForm, errMsg string) {
	@layout.Shell(shell("New repository · "+Brand, layout.LeftNav, n)) {
		@NewRepoContent(f, errMsg)
	}
}

templ NewRepoContent(f NewRepoForm, errMsg string) {
	<div class="flex h-full flex-1 flex-col overflow-hidden">
		<div class="shrink-0">
			@PageHead("New Repository", "Anyone can create a repository; you become its creator.", "")
		</div>
		<div class="flex-1 overflow-y-auto">
			<div class="mx-auto w-full max-w-5xl px-6 pb-12 sm:px-10">
				if errMsg != "" {
					<div class="max-w-xl rounded-lg border border-red-900/50 bg-red-950/20 px-4 py-3 text-sm text-red-400">{ errMsg }</div>
				}
				<form method="post" action="/repositories/new" class="max-w-xl space-y-5">
					<div>
						<label class="mb-2 block text-sm font-medium text-zinc-400">Repository Name</label>
						<input name="name" type="text" value={ f.Name } required autofocus autocomplete="off" spellcheck="false" placeholder="my-project" class="w-full rounded-lg border border-zinc-800 bg-zinc-900/50 px-3.5 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-600 transition-colors focus:border-zinc-600 focus:outline-none"/>
					</div>
					<div class="rounded-lg border border-zinc-800 bg-zinc-900/30 px-3.5 py-2.5 text-sm text-zinc-500">
						Every repository is readable by everyone. Its main starts empty: clone it with <span class="font-mono text-zinc-400">jj clone</span>, make a change, and upload it with <span class="font-mono text-zinc-400">jj cl</span>.
					</div>
					<div class="flex items-center gap-3 pt-2">
						<button type="submit" class={ btnClass(btnInverse) }>Create Repository</button>
						<a href="/" hx-get="/" hx-target="#content" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class="text-sm text-zinc-400 transition-colors hover:text-zinc-200">Cancel</a>
					</div>
				</form>
			</div>
		</div>
	</div>
}

// ErrorPage / ErrorContent render a page that could not be shown: what went wrong, and why.
templ ErrorPage(n nav.Model, title, message string) {
	@layout.Shell(shell(title+" · "+Brand, layout.LeftNav, n)) {
		@ErrorContent(title, message)
	}
}

templ ErrorContent(title, message string) {
	<div class="flex h-full flex-1 flex-col overflow-hidden">
		<div class="shrink-0">
			@PageHead(title, message, "") {
				<a href="/" hx-get="/" hx-target="#content" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class={ btnClass(btnSecondary) }>Repositories</a>
			}
		</div>
	</div>
}
