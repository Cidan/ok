package pages

import (
	"strconv"

	"github.com/Cidan/ok/internal/web/breadcrumb"
	"github.com/Cidan/ok/internal/web/clipboard"
	"github.com/Cidan/ok/internal/web/layout"
	"github.com/Cidan/ok/internal/web/nav"
)

// PageHead is the page header of every ok page outside a repository (the dashboard's lists, the
// repositories, a new repository, the services, the notifications, an error). It fixes the title
// + subtitle geometry — same position, same size, same block height — so the heading never shifts
// as you move between pages. title is the heading; subtitle sits directly under it (always
// rendered, so the block height is constant even when a page has nothing to say); badge, when set,
// is a chip after the title; children are the page's right-aligned actions (a button, …). A
// repository's pages have repoHead instead.
templ PageHead(title, subtitle, badge string) {
	<div class="mx-auto w-full max-w-5xl px-6 pt-10 pb-7 sm:px-10">
		@pageHeadInner(title, subtitle, badge) {
			{ children... }
		}
	</div>
}

// PageHeadWide is PageHead across the whole content region, for a page that fills it (a group of
// services): the same title block and actions at the same height, edge to edge.
templ PageHeadWide(title, subtitle, badge string) {
	<div class="w-full px-6 pt-10 pb-7 sm:px-10">
		@pageHeadInner(title, subtitle, badge) {
			{ children... }
		}
	</div>
}

templ pageHeadInner(title, subtitle, badge string) {
	<div class="flex items-start justify-between gap-4">
		<div class="min-w-0">
			<div class="flex items-center gap-2.5">
				<h1 class="truncate text-3xl font-semibold tracking-tight text-fg">{ title }</h1>
				if badge != "" {
					@chip(toneNeutral) {
						{ badge }
					}
				}
			</div>
			<p class="mt-2 truncate text-base text-muted">{ subtitle }</p>
		</div>
		<div class="flex shrink-0 items-center gap-2 pt-0.5">
			{ children... }
		</div>
	</div>
}

// --- A repository's header ---------------------------------------------------------------------

// repoHead is the header of every page in a repository, in one row: its mark, name, and creator
// (or, a fork, what it is a fork of), the repository's tabs — Code (its files), Changes (its CLs),
// History (main's commits), Search (main's code), and, for its administrators, Webhooks — and its
// actions: a fork's Sync, Fork, and the Code clone popover. It names the repository (data-repo-name) for the command palette. It sits above the page's region (#repo-main) and stays put as a navigation
// swaps that region; nav.js moves the current tab after each swap (the tabs are a
// [data-nav-group] of data-nav-link links, matched by their paths). Its width follows the page
// beneath it — the wide pages (a CL, a run, a deployment) mark their root data-wide, and the
// header grows to match (group/repo's :has) — so their edges line up whichever page is shown.
// full spans the content region instead, above the browser. target is what the tabs swap:
// #repo-main, or #content from the browser, whose layout the other pages do not share.
templ repoHead(c RepoChrome, tab, target string, full bool) {
	<header data-repo-name={ c.Name } class="shrink-0 overflow-hidden border-b border-line-soft [scrollbar-gutter:stable]">
		<div class={ repoHeadWidth(full) }>
			<div class="flex flex-wrap items-end gap-x-8 gap-y-1 pt-5">
				<div class="flex min-w-0 items-center gap-3 pb-3">
					<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-accent-soft text-accent-fg ring-1 ring-inset ring-accent-line">
						@iconRepo("h-[18px] w-[18px]")
					</span>
					<div class="min-w-0">
						<h1 class="truncate text-lg leading-6 font-semibold tracking-tight text-fg">{ c.Name }</h1>
						if c.Upstream != "" {
							<p data-upstream class="truncate text-xs text-subtle">
								Fork of <a href={ templ.SafeURL(c.UpstreamHref) } hx-get={ c.UpstreamHref } hx-target="#content" hx-swap={ swapNav } hx-push-url="true" class="font-mono text-body transition-colors hover:text-accent-fg">{ c.Upstream }</a>
							</p>
						} else {
							<p class="truncate text-xs text-subtle">{ c.Subtitle }</p>
						}
					</div>
				</div>
				<nav data-nav-group aria-label="Repository" class="order-last flex w-full items-end gap-1 overflow-x-auto sm:order-none sm:w-auto">
					@repoTab(c.Link, repoTabMatch(c, tabCode), "g c", target, tab == tabCode) {
						@iconCode()
						Code
					}
					@repoTab(c.ChangesHref, repoTabMatch(c, tabChanges), "g l", target, tab == tabChanges) {
						@iconChanges()
						Changes
					}
					@repoTab(c.CommitsHref, repoTabMatch(c, tabHistory), "g y", target, tab == tabHistory) {
						@iconHistory()
						History
						if c.CommitsCount > 0 {
							<span data-commits class="tabular-nums text-faint">{ strconv.FormatInt(c.CommitsCount, 10) }</span>
						}
					}
					@repoTab(c.Link+"/search", repoTabMatch(c, tabSearch), "g f", target, tab == tabSearch) {
						@iconSearch()
						Search
					}
					if c.WebhooksHref != "" {
						@repoTab(c.WebhooksHref, repoTabMatch(c, tabWebhooks), "", target, tab == tabWebhooks) {
							@iconWebhook()
							Webhooks
						}
					}
				</nav>
				<div class="ml-auto flex shrink-0 items-center gap-2 pb-2.5">
					@forkControls(c)
					@codeButton(c.Clone)
				</div>
			</div>
		</div>
	</header>
}

// repoTab is one of a repository's tabs: a navigation of target, underlined in the accent while
// it is the current one (aria-current, kept by nav.js), reached too by its shortcut (ok.js). A
// tab with nowhere to go is shown dimmed.
templ repoTab(href, match, shortcut, target string, current bool) {
	if href != "" {
		<a
			href={ templ.SafeURL(href) }
			hx-get={ href }
			hx-target={ target }
			hx-swap={ swapNav }
			hx-push-url="true"
			data-nav-link
			data-nav-match={ match }
			if shortcut != "" {
				data-shortcut={ shortcut }
			}
			if current {
				aria-current="page"
			}
			class="group/tab relative shrink-0 pb-2.5 text-sm font-medium text-subtle transition-colors hover:text-body aria-[current=page]:text-fg after:absolute after:inset-x-1 after:bottom-0 after:h-0.5 after:rounded-full after:bg-[linear-gradient(90deg,var(--color-accent-hi),var(--color-accent),var(--color-ember))] after:scale-x-0 after:transition-transform after:duration-300 aria-[current=page]:after:scale-x-100 [&[aria-current=page]_svg]:text-accent-fg"
		>
			<span class="flex items-center gap-2 rounded-lg px-2.5 py-1.5 transition-colors group-hover/tab:bg-hover">
				{ children... }
			</span>
		</a>
	} else {
		<span class="shrink-0 pb-2.5 text-sm font-medium text-ghost">
			<span class="flex items-center gap-2 px-2.5 py-1.5">
				{ children... }
			</span>
		</span>
	}
}

// RepoViewPage / RepoViewContent render a repository's landing — its root, centered: the
// repository's header, the commit chip + breadcrumb, the root's listing with per-entry
// last-commit, and the rendered README. RepoViewContent is the swappable region. An entry opens
// the browser (browse.templ), which replaces this whole content region.
templ RepoViewPage(n nav.Model, v RepoView) {
	@layout.Shell(shell(v.Chrome.Name+" · "+Brand, layout.TopNav, n)) {
		@RepoViewContent(v)
	}
}

templ RepoViewContent(v RepoView) {
	<div class="group/repo flex h-full flex-1 flex-col overflow-hidden">
		@repoHead(v.Chrome, tabCode, "#repo-main", false)
		<div id="repo-main" data-hydrate class="hydrating flex-1 overflow-y-auto">
			@RepoViewMain(v)
		</div>
	</div>
}

// RepoViewMain is the swappable in-repo region below the shared header — the toolbar, the
// file list, and the README (or the empty-repo quick-start). Every in-repo navigation htmx-swaps
// THIS (#repo-main), so the repo header + nav rail never reload; ServeRepoView returns it alone
// on an HX-Target=repo-main request.
templ RepoViewMain(v RepoView) {
	<div class="mx-auto w-full max-w-5xl px-6 pt-6 pb-16 sm:px-10">
		if v.IsEmpty {
			@emptyRepo(v.Chrome)
		} else {
			@repoToolbar(v.Chrome)
			@fileList(v)
			if v.Readme != nil {
				@readmeCard(*v.Readme)
			}
		}
	</div>
}

// repoToolbar is the row above the file list: the commit being browsed and the path breadcrumb.
// (main's commit count is on the History tab.)
templ repoToolbar(c RepoChrome) {
	<div class="mb-4 flex min-h-9 flex-wrap items-center gap-3">
		@atChip(c.At, "#repo-main")
		@breadcrumb.Trail(c.Crumbs, "")
	</div>
}

// fileList is the landing's root listing: the "latest commit" bar as its header, then one row
// per entry. An entry opens the browser in place of the landing (#content); a commit opens in
// the landing's region (#repo-main).
templ fileList(v RepoView) {
	@panel() {
		@latestCommitBar(v.Latest, "#repo-main")
		<div class="divide-y divide-line-soft">
			for _, e := range v.Entries {
				@entryRow(e, "#content", swapNav, "#repo-main")
			}
		</div>
	}
}

// latestCommitBar is a listing panel's header: the latest commit that changed the directory —
// who, its message (a link to the commit, which swaps commitTarget), and when.
templ latestCommitBar(lc LatestCommit, commitTarget string) {
	@panelHead() {
		if lc.Present {
			@avatar(lc.Author)
			<span class="shrink-0 text-body">{ lc.Author }</span>
			if lc.Href != "" {
				<a href={ templ.SafeURL(lc.Href) } hx-get={ lc.Href } hx-target={ commitTarget } hx-swap={ swapNav } hx-push-url="true" class="min-w-0 flex-1 truncate font-normal text-subtle transition-colors hover:text-fg">{ lc.Message }</a>
			} else {
				<span class="min-w-0 flex-1 truncate font-normal text-subtle">{ lc.Message }</span>
			}
			<span class="shrink-0 whitespace-nowrap font-normal text-faint" title={ lc.AgeTitle }>{ lc.Age }</span>
		} else {
			<span class="font-normal text-subtle">No commits yet</span>
		}
	}
}

// entryRow is one tree entry. The whole row is NOT a single anchor (that would nest the commit
// link inside it) — the name and the commit message are separate links within a hover row. The
// name swaps target (with swap, the swap spec), the commit message commitTarget.
templ entryRow(e EntryItem, target, swap, commitTarget string) {
	<div class="group flex items-center gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-hover">
		if e.IsLink {
			<span class="shrink-0 text-muted">
				@iconSymlink()
			</span>
		} else if e.IsDir {
			<span class="shrink-0 text-accent">
				@iconFolder()
			</span>
		} else {
			<span class="shrink-0 text-subtle">
				@iconFile()
			</span>
		}
		if e.Href != "" {
			<a href={ templ.SafeURL(e.Href) } hx-get={ e.Href } hx-target={ target } hx-swap={ swap } hx-push-url="true" class={ "truncate transition-colors hover:text-accent-fg", templ.KV("font-medium text-fg", e.IsDir), templ.KV("text-body", !e.IsDir) }>{ e.Name }</a>
		} else {
			<span class={ "truncate", templ.KV("font-medium text-fg", e.IsDir), templ.KV("text-body", !e.IsDir) }>{ e.Name }</span>
		}
		<span class="min-w-0 flex-1"></span>
		if e.CommitMsg != "" {
			if e.CommitHref != "" {
				<a href={ templ.SafeURL(e.CommitHref) } hx-get={ e.CommitHref } hx-target={ commitTarget } hx-swap={ swapNav } hx-push-url="true" class="hidden max-w-[45%] truncate text-sm text-subtle transition-colors hover:text-fg md:block">{ e.CommitMsg }</a>
			} else {
				<span class="hidden max-w-[45%] truncate text-sm text-subtle md:block">{ e.CommitMsg }</span>
			}
		}
		if e.Age != "" {
			<span class="min-w-24 shrink-0 whitespace-nowrap text-right text-sm text-faint" title={ e.AgeTitle }>{ e.Age }</span>
		}
	</div>
}

// readmeCard renders the discovered README below the file list: a filename header bar and the
// server-rendered, sanitized markup body (styled by the `.markup` prose rules in input.css).
templ readmeCard(r ReadmeView) {
	<div class="mt-6">
		@panel() {
			@panelHead() {
				<span class="text-accent-fg">
					@iconBook()
				</span>
				<h3>{ r.Name }</h3>
			}
			<div class="markup px-6 py-7 sm:px-10">
				@templ.Raw(r.HTML)
			</div>
		}
	</div>
}

// fileCard renders one file's content, in the browser's pane, in the mode the backend chose.
// Blame opens in the pane; History, a page of its own, in place of the browser. The views of the
// file — History, Blame, Raw — are one segmented control in its header.
templ fileCard(f FileBlob) {
	@panel() {
		@panelHead() {
			<span class="text-subtle">
				@iconFile()
			</span>
			<span class="whitespace-nowrap">{ f.SizeHuman }</span>
			if f.LexerName != "" {
				<span class="text-ghost">·</span>
				<span class="min-w-0 truncate">{ f.LexerName }</span>
			}
			<span class="flex-1"></span>
			<span class="flex shrink-0 items-center divide-x divide-line overflow-hidden rounded-lg border border-line font-normal">
				if f.HistoryHref != "" {
					<a href={ templ.SafeURL(f.HistoryHref) } hx-get={ f.HistoryHref } hx-target="#content" hx-swap={ swapNav } hx-push-url="true" class={ segmentClass }>History</a>
				}
				if f.BlameHref != "" {
					<a href={ templ.SafeURL(f.BlameHref) } hx-get={ f.BlameHref } hx-target="#browse-main" hx-swap={ swapPane } hx-push-url="true" class={ segmentClass }>Blame</a>
				}
				if f.RawHref != "" {
					<a href={ templ.SafeURL(f.RawHref) } class={ segmentClass }>Raw</a>
				}
			</span>
		}
		switch f.Mode {
			case "markup":
				<div class="markup px-6 py-7 sm:px-10">
					@templ.Raw(f.HTML)
				</div>
			case "source":
				@sourceView(f)
			case "image":
				<div class="flex justify-center bg-sunken bg-[conic-gradient(var(--color-hover)_25%,transparent_0_50%,var(--color-hover)_0_75%,transparent_0)] bg-[length:16px_16px] p-8">
					<img src={ f.ImageSrc } alt={ f.Name } class="max-w-full rounded-lg shadow-pop"/>
				</div>
			default:
				@panelEmpty() {
					This file can't be displayed here.
					if f.RawHref != "" {
						<a href={ templ.SafeURL(f.RawHref) } class="text-accent-fg underline decoration-accent-line underline-offset-4 hover:decoration-accent-fg">Download</a>
					}
				}
		}
	}
}

// sourceView is a line-numbered, syntax-highlighted code table. Each line is server-highlighted
// (chroma) HTML; the `.chroma` scope on the table resolves the token color classes. The line a
// link points at (#Lnn) is lit in the accent.
templ sourceView(f FileBlob) {
	<div class="chroma overflow-x-auto py-1.5">
		<table class="w-full border-collapse font-mono text-[12.5px] leading-[1.6]">
			<tbody>
				for i, line := range f.Lines {
					<tr class="transition-colors hover:bg-hover has-[:target]:bg-accent-soft">
						<td class="w-[1%] select-none whitespace-nowrap pl-4 pr-3 text-right align-top text-faint">
							<a href={ templ.SafeURL("#L" + strconv.Itoa(i+1)) } id={ "L" + strconv.Itoa(i+1) } class="text-faint transition-colors hover:text-accent-fg">{ strconv.Itoa(i + 1) }</a>
						</td>
						<td class="w-full whitespace-pre border-l border-line-soft px-4 align-top text-fg">
							@templ.Raw(string(line))
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// emptyRepo is the quick-start state for a repository whose main has nothing on it yet: how to
// clone it with ok's jj, make a first change, and upload it as a changelist.
templ emptyRepo(c RepoChrome) {
	@panel() {
		@panelTitle("Quick Setup")
		@panelBody() {
			<p class="text-sm text-subtle">Nothing has landed on main yet. Clone the repository with ok's jj, make a change, and upload it for review; it lands on main when it is submitted.</p>
			@cloneRow("Clone", c.Clone.Command)
			<div class="mt-6 text-sm font-medium text-muted">A First Change</div>
			<pre class="mt-2 overflow-x-auto rounded-lg border border-line bg-sunken px-4 py-3 font-mono text-sm leading-relaxed text-body">{ c.Clone.Command + "\ncd " + c.Name + "\n# make a change, then describe it and upload it:\njj describe -m 'the first change'\njj cl --ready" }</pre>
		}
	}
}

// forkControls are a fork's Sync button, and every repository's Fork link, where the person may.
templ forkControls(c RepoChrome) {
	if c.SyncAction != "" {
		<form method="post" action={ templ.SafeURL(c.SyncAction) }>
			<button type="submit" class={ btnClass(btnSecondary) } title={ "Bring it " + c.Upstream + "'s newer work" }>
				@iconSync()
				Sync Fork
			</button>
		</form>
	}
	if c.ForkHref != "" {
		<a href={ templ.SafeURL(c.ForkHref) } hx-get={ c.ForkHref } hx-target="#content" hx-swap={ swapNav } hx-push-url="true" class={ btnClass(btnSecondary) }>
			@iconFork()
			Fork
		</a>
	}
}

templ iconChanges() {
	<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z"></path></svg>
}

// codeButton is the "Code" clone popover, headed like a panel: the jj clone command with a copy
// button (the clipboard component). ok's jj is the only client. It floats (fixed, placed under the
// button by clcomments.js), so the header, which clips, never cuts it off.
templ codeButton(c CloneURLs) {
	<button type="button" data-popover-open="repo-clone" data-popover-anchor="end" aria-haspopup="dialog" aria-expanded="false" class={ btnClass(btnInverse), "group/code" }>
		@iconCode()
		Code
		<span class="opacity-60 transition-transform group-aria-expanded/code:rotate-180">
			@iconChevron()
		</span>
	</button>
	<div id="repo-clone" data-popover hidden role="dialog" aria-label="Clone" class={ popoverClass, "fixed z-30 w-[22rem]" }>
		@panelTitle("Clone")
		<div class="px-4 pb-4">
			@cloneRow("With ok's jj", c.Command)
		</div>
	</div>
}

// cloneRow is one labelled, read-only clone command with a copy button.
templ cloneRow(label, url string) {
	<div class="mt-3">
		<div class="mb-1.5 text-sm text-muted">{ label }</div>
		<div class="flex items-center gap-2 rounded-lg border border-line bg-sunken py-1 pl-3 pr-1">
			<span class="select-none font-mono text-sm text-faint">$</span>
			<input readonly value={ url } class="min-w-0 flex-1 bg-transparent font-mono text-sm text-fg focus:outline-none"/>
			@clipboard.Button(url, "shrink-0 rounded-md p-1.5 text-muted transition-colors hover:bg-hover-strong hover:text-fg") {
				<span data-copy-idle>
					@iconCopy()
				</span>
				<span data-copy-done class="hidden text-success">
					@iconCheck()
				</span>
			}
		</div>
	</div>
}

// atChip names the commit being browsed: main's head, or an older commit with a link back to
// main, which swaps target.
templ atChip(at CommitAt, target string) {
	if at.Short == "" {
		<span class="flex items-center gap-2 rounded-lg border border-line bg-surface px-3 py-1.5 text-sm font-medium text-fg shadow-panel">
			<span class="text-accent-fg">
				@iconBranch()
			</span>
			main
		</span>
	} else {
		<span class="flex items-center gap-2 rounded-lg border border-warn-line bg-warn-soft px-3 py-1.5 text-sm text-body">
			<span class="text-warn">
				@iconCommit()
			</span>
			<span class="font-mono text-fg">{ at.Short }</span>
			if at.MainHref != "" {
				<a href={ templ.SafeURL(at.MainHref) } hx-get={ at.MainHref } hx-target={ target } hx-swap={ swapNav } hx-push-url="true" class="text-subtle transition-colors hover:text-fg">Back to main</a>
			}
		</span>
	}
}

// --- Commit history ------------------------------------------------------------------------

// CommitsPage / CommitsContent render main's history: the repository's header, the commit rows
// (optionally only those touching a path), and a pager.
templ CommitsPage(n nav.Model, v CommitsView) {
	@layout.Shell(shell("Commits · "+v.Chrome.Name+" · "+Brand, layout.TopNav, n)) {
		@CommitsContent(v)
	}
}

templ CommitsContent(v CommitsView) {
	<div class="group/repo flex h-full flex-1 flex-col overflow-hidden">
		@repoHead(v.Chrome, tabHistory, "#repo-main", false)
		<div id="repo-main" data-hydrate class="hydrating flex-1 overflow-y-auto">
			@CommitsMain(v)
		</div>
	</div>
}

// CommitsMain is the swappable in-repo region for the commit history — the commit rows and
// the pager. Swapped as #repo-main; ServeCommits returns it alone on an
// HX-Target=repo-main request.
templ CommitsMain(v CommitsView) {
	<div class="mx-auto w-full max-w-5xl px-6 pt-6 pb-16 sm:px-10">
		@panel() {
			@panelHead() {
				<h3>Commits on Main</h3>
				if v.FilePath != "" {
					<span class="text-ghost">·</span>
					<span class="min-w-0 truncate font-mono font-normal text-muted">{ v.FilePath }</span>
				}
				<span class="flex-1"></span>
				if v.Count > 0 {
					<span class="shrink-0 whitespace-nowrap font-normal text-subtle"><span class="font-medium text-body">{ strconv.FormatInt(v.Count, 10) }</span> { pluralize(v.Count, "commit", "commits") }</span>
				}
			}
			if len(v.Commits) == 0 {
				@panelEmpty() {
					No commits found.
				}
			} else {
				<div class="divide-y divide-line-soft">
					for _, c := range v.Commits {
						@commitRow(c)
					}
				</div>
			}
		}
		if len(v.Commits) > 0 {
			@commitPager(v)
		}
	</div>
}

// commitRow is one commit in the history: its author's badge, the subject (linked to its diff),
// author + age + the CL it landed from, and a trailing control cluster — the short commit ID
// (→ diff), a copy button, and a "browse the tree at this commit" link.
templ commitRow(c CommitRow) {
	<div class="group flex items-center gap-3.5 px-4 py-3 text-sm transition-colors hover:bg-hover">
		@avatar(c.Author)
		<div class="min-w-0 flex-1">
			<a href={ templ.SafeURL(c.Href) } hx-get={ c.Href } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class="block truncate font-medium text-fg transition-colors hover:text-accent-fg">{ c.Title }</a>
			<div class="mt-0.5 flex flex-wrap items-center gap-2 text-sm text-subtle">
				<span class="font-medium text-muted">{ c.Author }</span>
				<span class="text-ghost">·</span>
				<span title={ c.AgeTitle }>{ c.Age }</span>
				if c.CLHref != "" {
					<a href={ templ.SafeURL(c.CLHref) } hx-get={ c.CLHref } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class={ chipClass(toneNeutral), "transition-colors hover:border-accent-line hover:text-accent-fg" }>CL { strconv.FormatInt(c.CL, 10) }</a>
				}
			</div>
		</div>
		<div class="flex shrink-0 items-center gap-1">
			<a href={ templ.SafeURL(c.Href) } hx-get={ c.Href } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class="rounded-lg border border-line bg-sunken px-2 py-1 font-mono text-sm text-body transition-colors hover:border-accent-line hover:text-accent-fg">{ c.ShortSHA }</a>
			@clipboard.Button(c.SHA, "rounded-lg p-1.5 text-subtle transition-colors hover:bg-hover-strong hover:text-fg") {
				<span data-copy-idle>
					@iconCopy()
				</span>
				<span data-copy-done class="hidden text-success">
					@iconCheck()
				</span>
			}
			<a href={ templ.SafeURL(c.BrowseHref) } hx-get={ c.BrowseHref } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" title="Browse the repository at this commit" class="rounded-lg p-1.5 text-subtle transition-colors hover:bg-hover-strong hover:text-fg">
				@iconCode()
			</a>
		</div>
	</div>
}

// commitPager is the newer/older pair for the commit history (only rendered when a neighbour page
// exists; the unavailable direction is a disabled button).
templ commitPager(v CommitsView) {
	if v.PrevHref != "" || v.NextHref != "" {
		<div class="mt-4 flex items-center justify-between">
			if v.PrevHref != "" {
				<a href={ templ.SafeURL(v.PrevHref) } hx-get={ v.PrevHref } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class={ btnClass(btnSecondary) }>Newer</a>
			} else {
				<span class={ btnClass(btnDisabled) }>Newer</span>
			}
			if v.NextHref != "" {
				<a href={ templ.SafeURL(v.NextHref) } hx-get={ v.NextHref } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class={ btnClass(btnSecondary) }>Older</a>
			} else {
				<span class={ btnClass(btnDisabled) }>Older</span>
			}
		</div>
	}
}

// --- Single-commit diff --------------------------------------------------------------------

// CommitDiffPage / CommitDiffContent render one commit: the repository's header, the commit
// message + metadata card, a changed-files stat bar, and one card per changed file.
templ CommitDiffPage(n nav.Model, v CommitDiffView) {
	@layout.Shell(shell(v.ShortSHA+" · "+v.Chrome.Name+" · "+Brand, layout.TopNav, n)) {
		@CommitDiffContent(v)
	}
}

templ CommitDiffContent(v CommitDiffView) {
	<div class="group/repo flex h-full flex-1 flex-col overflow-hidden">
		@repoHead(v.Chrome, tabHistory, "#repo-main", false)
		<div id="repo-main" data-hydrate class="hydrating flex-1 overflow-y-auto">
			@CommitDiffMain(v)
		</div>
	</div>
}

// CommitDiffMain is the swappable in-repo region for one commit — the message/metadata card, the
// stat bar, and the per-file diffs. Swapped as #repo-main; ServeCommitDiff returns it alone on an
// HX-Target=repo-main request.
templ CommitDiffMain(v CommitDiffView) {
	<div class="mx-auto w-full max-w-5xl px-6 pt-6 pb-16 sm:px-10">
		@commitHeader(v)
		@diffStatBar(v)
		@panel() {
			@fileTableHead()
			if len(v.Files) == 0 {
				@panelEmpty() {
					No file changes.
				}
			} else {
				@FileRows(v.Files, v.MoreFilesHref)
			}
		}
	</div>
}

// commitHeader is the commit's identity, mirroring the CL view: the subject as the page title, then
// a Commit Message panel whose header carries the author + age, the CL it landed from, the parent
// link(s), the change ID, and the commit ID with a copy button.
templ commitHeader(v CommitDiffView) {
	<h2 class="mb-4 text-xl font-semibold tracking-tight text-fg">{ v.Title }</h2>
	<div class="mb-4">
		@panel() {
			@panelHead() {
				@avatar(v.Author)
				<span class="text-body">{ v.Author }</span>
				<span class="font-normal text-subtle" title={ v.AgeTitle }>committed { v.Age }</span>
				if v.CLHref != "" {
					<a href={ templ.SafeURL(v.CLHref) } hx-get={ v.CLHref } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class={ chipClass(toneNeutral), "transition-colors hover:border-accent-line hover:text-accent-fg" }>CL { strconv.FormatInt(v.CL, 10) }</a>
				}
				<span class="flex-1"></span>
				if len(v.Parents) > 0 {
					<span class="font-normal text-faint">Parent</span>
					for _, p := range v.Parents {
						<a href={ templ.SafeURL(p.Href) } hx-get={ p.Href } hx-target="#repo-main" hx-swap={ swapNav } hx-push-url="true" class={ chipClass(toneNeutral), "font-mono transition-colors hover:border-accent-line hover:text-accent-fg" }>{ p.ShortSHA }</a>
					}
				}
				<span class={ chipClass(toneNeutral), "font-mono" } title="Change ID">{ v.ChangeID }</span>
				<span class={ chipClass(toneNeutral), "font-mono" } title="Commit ID">{ v.ShortSHA }</span>
				@clipboard.Button(v.SHA, "rounded-lg p-1 text-subtle transition-colors hover:bg-hover-strong hover:text-fg") {
					<span data-copy-idle>
						@iconCopy()
					</span>
					<span data-copy-done class="hidden text-success">
						@iconCheck()
					</span>
				}
			}
			<pre class="whitespace-pre-wrap px-4 py-3.5 font-mono text-sm leading-relaxed text-body">{ clFullMessage(v.Title, v.Body) }</pre>
		}
	</div>
}

// diffStatBar is the "N files changed, +X −Y" summary line above the file list.
templ diffStatBar(v CommitDiffView) {
	<div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-subtle">
		<span><span class="font-medium text-body">{ strconv.Itoa(v.NumFiles) }</span> { pluralize(int64(v.NumFiles), "file", "files") } changed</span>
		if v.TotalsKnown {
			@diffStat(v.Addition, v.Deletion)
		}
		<span class="flex-1"></span>
		@diffViewToggle()
	</div>
}

// fileTableHead is a file list's column labels.
templ fileTableHead() {
	@panelHead() {
		<span class="w-24 shrink-0">Status</span>
		<span class="flex-1">File</span>
		<span class="shrink-0">Delta</span>
		<span class="w-4 shrink-0"></span>
	}
}

// FileRows is a page of a file list's rows — a CL's or a commit's — and, when there are more,
// the loader that fetches the next page as it scrolls into view.
templ FileRows(rows []DiffFileView, next string) {
	for _, f := range rows {
		@fileRow(f)
	}
	if next != "" {
		<div data-live hx-get={ next } hx-trigger="intersect once" hx-swap="outerHTML">
			@loading("Loading more files…")
		</div>
	}
}

// fileRow is one changed file: its status, path, review threads, and ±counts, and — once
// opened — its diff, which it loads then (a row that starts open loads it as it scrolls into
// view).
templ fileRow(f DiffFileView) {
	<details id={ f.Anchor } class="group border-b border-line-soft last:border-b-0" open?={ f.Open }>
		<summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-hover group-open:bg-neutral-soft [&::-webkit-details-marker]:hidden">
			<span class="shrink-0 sm:w-24">
				@diffStatusPill(f.Status)
			</span>
			<span class="flex min-w-0 flex-1 items-center gap-2 font-mono">
				if f.OldName != "" && f.OldName != f.Name {
					<span class="min-w-0 truncate text-subtle">{ f.OldName }</span>
					<span class="shrink-0 text-faint">→</span>
				}
				<span data-file-name class="min-w-0 truncate text-fg">{ f.Name }</span>
			</span>
			if f.ThreadCount > 0 {
				<span title="review comments" class="hidden sm:inline">
					@chip(toneInfo) {
						{ pluralCount(f.ThreadCount, "Comment", "Comments") }
					}
				</span>
			}
			if f.OffDiff {
				<span class="shrink-0 text-faint">—</span>
			} else if !f.IsBinary {
				@diffStat(f.Addition, f.Deletion)
			}
			<span class="flex w-4 shrink-0 justify-center text-faint transition-transform group-open:rotate-180">
				@iconChevron()
			</span>
		</summary>
		<div class="border-t border-line-soft">
			<div data-live hx-get={ f.BodyHref } hx-trigger="intersect once" hx-swap="outerHTML">
				@loading("Loading the diff…")
			</div>
		</div>
	</details>
}

// FileBody is a commit's file's diff, which its row loads when opened.
templ FileBody(f DiffFileView) {
	<div data-live>
		@diffFileBody(f)
	</div>
}

// diffFileBody is one file's diff content (binary/too-large/generated placeholder, or the
// line-numbered diff table). Split out of diffFile so the CL file table can embed it under an
// expandable row.
templ diffFileBody(f DiffFileView) {
	if f.IsBinary {
		@panelEmpty() {
			Binary file not shown.
		}
	} else if f.TooLarge {
		@panelEmpty() {
			This file's diff is too large to display.
		}
	} else if f.Collapsed {
		@panelEmpty() {
			This file is generated or vendored and is hidden by default.
		}
	} else if len(f.Sections) == 0 {
		@panelEmpty() {
			No changes.
		}
	} else {
		<div class="chroma overflow-x-auto">
			<table class="q-diff-unified w-full border-collapse font-mono text-[12.5px] leading-[1.6]">
				<tbody>
					for _, sec := range f.Sections {
						for _, ln := range sec {
							@diffLine(ln)
						}
					}
				</tbody>
			</table>
			@splitTable(f, "", false, false)
		</div>
	}
}

// splitTable is a file's diff side by side — the base on the left, the change on the right — which
// a reader who prefers it sees instead of the unified table (<html data-diff="split">). A CL's
// (threads) has every review thread follow its row, and — when the reader may comment — each
// side's lines take a comment.
templ splitTable(f DiffFileView, filePath string, threads, comments bool) {
	<table class="q-diff-split w-full table-fixed border-collapse font-mono text-[12.5px] leading-[1.6]">
		<colgroup>
			<col class="w-14"/>
			<col/>
			<col class="w-14"/>
			<col/>
		</colgroup>
		<tbody>
			for _, sec := range f.Sections {
				for _, row := range splitRows(sec) {
					if row.Tag != "" {
						<tr class="select-none bg-hunk text-subtle">
							<td colspan="4" class="truncate px-3 py-1.5">
								@templ.Raw(row.Tag)
							</td>
						</tr>
					} else {
						<tr class="cl-diff-row">
							@splitSide(row.Left, "left", filePath, comments)
							@splitSide(row.Right, "right", filePath, comments)
						</tr>
						if threads {
							for _, t := range row.threads() {
								<tr class="border-y border-line-soft bg-sunken">
									<td colspan="4" class="px-3 py-3 font-sans text-sm leading-normal">
										<div class="max-w-3xl">
											@clThread(t, comments, false)
										</div>
									</td>
								</tr>
							}
						}
					}
				}
			}
		</tbody>
	</table>
}

// splitSide is one side of a split row: the line's number (with the comment control, when
// comments are taken), and the line; an empty side where the other has more lines.
templ splitSide(ln *DiffLineRow, side, filePath string, comments bool) {
	if ln == nil {
		<td class="bg-sunken"></td>
		<td class={ "bg-sunken", templ.KV("border-l border-line-soft", side == "right") }></td>
	} else {
		<td class={ "relative select-none whitespace-nowrap px-2 text-right align-top text-faint", splitSideClass(ln.Type, side) }>
			if comments && splitCommentable(ln, side) {
				<button type="button" class="cl-comment-add absolute top-[3px] left-1 flex h-[18px] w-[18px] cursor-pointer items-center justify-center rounded-md bg-accent font-semibold leading-none text-on-accent transition-colors hover:bg-accent-hi" data-file={ filePath } data-line={ splitAnchorLine(ln, side) } data-side={ side } title="Add comment">+</button>
			}
			{ splitLineNo(ln, side) }
		</td>
		<td class={ "whitespace-pre-wrap break-all py-px pr-3 pl-2 align-top text-fg", splitSideClass(ln.Type, side), templ.KV("border-l border-line-soft", side == "right") }>
			<span class={ diffMarkerClass(splitMarkerType(ln.Type, side)) }>{ diffMarker(splitMarkerType(ln.Type, side)) }</span>@templ.Raw(ln.Content)
		</td>
	}
}

// diffViewToggle switches the diff between unified and split, for every file at once
// (ok.js, which remembers the choice; d does it too).
templ diffViewToggle() {
	<span class="flex shrink-0 items-center rounded-lg border border-line bg-surface p-0.5 text-xs font-medium">
		<button type="button" data-diff-view="unified" title="Unified diff" class="cursor-pointer rounded-md px-2.5 py-1 text-subtle transition-colors hover:text-fg [:root:not([data-diff=split])_&]:bg-selected [:root:not([data-diff=split])_&]:text-fg">Unified</button>
		<button type="button" data-diff-view="split" title="Split diff" class="cursor-pointer rounded-md px-2.5 py-1 text-subtle transition-colors hover:text-fg [[data-diff=split]_&]:bg-selected [[data-diff=split]_&]:text-fg">Split</button>
	</span>
}

// diffLine is one row of a file diff: a hunk header spanning the row, or a two-gutter (old/new
// line number) code line coloured by change type. Content is server-highlighted HTML.
templ diffLine(ln DiffLineRow) {
	if ln.Type == "tag" {
		<tr class="select-none bg-hunk text-subtle">
			<td colspan="3" class="px-3 py-1.5">
				@templ.Raw(ln.Content)
			</td>
		</tr>
	} else {
		<tr class={ diffRowClass(ln.Type) }>
			<td class="w-[1%] select-none whitespace-nowrap px-2 text-right align-top text-faint">{ lineNo(ln.LeftIdx) }</td>
			<td class="w-[1%] select-none whitespace-nowrap px-2 text-right align-top text-faint">{ lineNo(ln.RightIdx) }</td>
			<td class="w-full whitespace-pre-wrap break-all py-px pl-2 pr-3 align-top text-fg">
				<span class={ diffMarkerClass(ln.Type) }>{ diffMarker(ln.Type) }</span>@templ.Raw(ln.Content)
			</td>
		</tr>
	}
}

// diffStatusPill is a changed file's status chip (Added / Modified / Deleted / Renamed / Copied).
templ diffStatusPill(status string) {
	@chip(diffStatusTone(status)) {
		{ diffStatusLabel(status) }
	}
}

// --- Blame -------------------------------------------------------------------------------

// blameLine is one line of a blame: at the start of each run of lines one commit changed, that
// commit (its short ID, author, and age, titled with its subject); then the line number and the
// highlighted line.
templ blameLine(l BlameLine) {
	<tr class={ "transition-colors hover:bg-hover has-[:target]:bg-accent-soft", templ.KV("border-t border-line-soft", l.First && l.Number > 1) }>
		<td class="w-[1%] max-w-[18rem] whitespace-nowrap border-r border-line-soft px-3 align-top font-sans text-sm" title={ l.CommitTitle }>
			if l.First {
				if l.CommitHref != "" {
					<a href={ templ.SafeURL(l.CommitHref) } hx-get={ l.CommitHref } hx-target="#content" hx-swap={ swapNav } hx-push-url="true" class="font-mono text-accent-fg transition-colors hover:text-fg">{ l.CommitShort }</a>
				}
				<span class="ml-2 text-subtle">{ l.Author }</span>
				<span class="ml-2 text-faint" title={ l.AgeTitle }>{ l.Age }</span>
			}
		</td>
		<td class="w-[1%] select-none whitespace-nowrap px-3 text-right align-top text-faint">
			<a href={ templ.SafeURL("#L" + strconv.Itoa(l.Number)) } id={ "L" + strconv.Itoa(l.Number) } class="text-faint transition-colors hover:text-accent-fg">{ strconv.Itoa(l.Number) }</a>
		</td>
		<td class="w-full whitespace-pre px-3 align-top text-fg">
			@templ.Raw(l.HTML)
		</td>
	</tr>
}

// --- Inline octicon glyphs (these pages' own; nav.templ's icon set is for the nav rail only) ---
templ iconFolder() {
	<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5a.25.25 0 0 1-.2-.1l-.9-1.2C6.07 1.26 5.55 1 5 1H1.75Z"></path></svg>
}

templ iconFile() {
	<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-9.5A1.75 1.75 0 0 1 2 14.25Zm1.75-.25a.25.25 0 0 0-.25.25v12.5c0 .138.112.25.25.25h9.5a.25.25 0 0 0 .25-.25V6h-2.75A1.75 1.75 0 0 1 9 4.25V1.5Zm6.75.062V4.25c0 .138.112.25.25.25h2.688a.252.252 0 0 0-.011-.013l-2.914-2.914a.272.272 0 0 0-.013-.011Z"></path></svg>
}

templ iconSymlink() {
	<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 1.75C2 .784 2.784 0 3.75 0h6.586c.464 0 .909.184 1.237.513l2.914 2.914c.329.328.513.773.513 1.237v9.586A1.75 1.75 0 0 1 13.25 16h-1.5a.75.75 0 0 1 0-1.5h1.5a.25.25 0 0 0 .25-.25V4.664a.25.25 0 0 0-.073-.177l-2.914-2.914a.25.25 0 0 0-.177-.073H3.75a.25.25 0 0 0-.25.25v6.5a.75.75 0 0 1-1.5 0v-6.5Z"></path><path d="m5.427 15.573 3.146-3.146a.25.25 0 0 0 0-.354L5.427 8.927A.25.25 0 0 0 5 9.104V11.5H.75a.75.75 0 0 0 0 1.5H5v2.396c0 .223.27.335.427.177Z"></path></svg>
}

templ iconChevron() {
	<svg class="h-3 w-3" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M12.78 5.22a.749.749 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.06 0L3.22 6.28a.749.749 0 1 1 1.06-1.06L8 8.939l3.72-3.719a.749.749 0 0 1 1.06 0Z"></path></svg>
}

templ iconCode() {
	<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="m11.28 3.22 4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734L13.94 8l-3.72-3.72a.749.749 0 0 1 .326-1.275.749.749 0 0 1 .734.215Zm-6.56 0a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042L2.06 8l3.72 3.72a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L.47 8.53a.75.75 0 0 1 0-1.06Z"></path></svg>
}

templ iconCopy() {
	<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M0 6.75C0 5.784.784 5 1.75 5h1.5a.75.75 0 0 1 0 1.5h-1.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 9.25 16h-7.5A1.75 1.75 0 0 1 0 14.25Z"></path><path d="M5 1.75C5 .784 5.784 0 6.75 0h7.5C15.216 0 16 .784 16 1.75v7.5A1.75 1.75 0 0 1 14.25 11h-7.5A1.75 1.75 0 0 1 5 9.25Zm1.75-.25a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h7.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25Z"></path></svg>
