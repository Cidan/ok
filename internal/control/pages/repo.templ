package pages

import (
	"strconv"

	"github.com/Cidan/ok/internal/web/breadcrumb"
	"github.com/Cidan/ok/internal/web/clipboard"
	"github.com/Cidan/ok/internal/web/layout"
	"github.com/Cidan/ok/internal/web/nav"
)

// PageHead is the shared page header used by EVERY ok page (dashboard, repositories, new
// repository, repo view). It fixes the title + subtitle geometry — same position, same size,
// same block height — so the heading never shifts as you move between pages. title is the
// heading; subtitle sits directly under it (always rendered, so the block height is constant
// even when a page has nothing to say); badge, when set, is a small pill after the title;
// children are the page's right-aligned actions (a button, a Code popover, …).
templ PageHead(title, subtitle, badge string) {
	<div class="mx-auto w-full max-w-5xl px-6 pt-10 pb-6 sm:px-10">
		@pageHeadInner(title, subtitle, badge) {
			{ children... }
		}
	</div>
}

// PageHeadWide is PageHead across the whole content region, for a page that fills it (the
// repository browser): the same title block and actions at the same height, edge to edge.
templ PageHeadWide(title, subtitle, badge string) {
	<div class="w-full px-6 pt-10 pb-6 sm:px-10">
		@pageHeadInner(title, subtitle, badge) {
			{ children... }
		}
	</div>
}

templ pageHeadInner(title, subtitle, badge string) {
	<div class="flex items-start justify-between gap-4">
		<div class="min-w-0">
			<div class="flex items-center gap-2.5">
				<h1 class="truncate text-2xl font-semibold tracking-tight text-zinc-50">{ title }</h1>
				if badge != "" {
					@chip(toneNeutral) {
						{ badge }
					}
				}
			</div>
			<p class="mt-1.5 truncate text-sm text-zinc-400">{ subtitle }</p>
		</div>
		<div class="flex shrink-0 items-center gap-2 pt-0.5">
			{ children... }
		</div>
	</div>
}

// RepoViewPage / RepoViewContent render a repository's landing — its root, centered: the shared
// header (name + Code clone popover), the commit chip + toolbar, the root's listing with
// per-entry last-commit, and the rendered README. RepoViewContent is the swappable region. An
// entry opens the browser (browse.templ), which replaces this whole content region.
templ RepoViewPage(n nav.Model, v RepoView) {
	@layout.Shell(shell(v.Chrome.Name+" · "+Brand, layout.LeftNav, n)) {
		@RepoViewContent(v)
	}
}

templ RepoViewContent(v RepoView) {
	<div class="flex h-full flex-1 flex-col overflow-hidden">
		<div class="shrink-0">
			@PageHead(v.Chrome.Name, v.Chrome.Subtitle, "") {
				@changesLink(v.Chrome.ChangesHref, "#repo-main")
				@codeButton(v.Chrome.Clone)
			}
		</div>
		<div id="repo-main" data-hydrate class="hydrating flex-1 overflow-y-auto">
			@RepoViewMain(v)
		</div>
	</div>
}

// RepoViewMain is the swappable in-repo region below the shared header — the toolbar, the
// file list, and the README (or the empty-repo quick-start). Every in-repo navigation htmx-swaps
// THIS (#repo-main), so the repo header + nav rail never reload; ServeRepoView returns it alone
// on an HX-Target=repo-main request.
templ RepoViewMain(v RepoView) {
	<div class="mx-auto w-full max-w-5xl px-6 pb-16 sm:px-10">
		if v.IsEmpty {
			@emptyRepo(v.Chrome)
		} else {
			@repoToolbar(v.Chrome)
			@fileList(v)
			if v.Readme != nil {
				@readmeCard(*v.Readme)
			}
		}
	</div>
}

// repoToolbar is the row above the file list: the commit being browsed, the path breadcrumb,
// and main's commit count.
templ repoToolbar(c RepoChrome) {
	<div class="mb-4 flex flex-wrap items-center gap-3">
		@atChip(c.At, "#repo-main")
		@breadcrumb.Trail(c.Crumbs, "")
		<span class="flex-1"></span>
		if c.CommitsCount > 0 {
			if c.CommitsHref != "" {
				<a href={ templ.SafeURL(c.CommitsHref) } hx-get={ c.CommitsHref } hx-target="#repo-main" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class="flex shrink-0 items-center gap-1.5 whitespace-nowrap text-sm text-zinc-500 transition-colors hover:text-zinc-200">
					<span class="text-zinc-500">
						@iconHistory()
					</span>
					<span class="font-medium text-zinc-300">{ strconv.FormatInt(c.CommitsCount, 10) }</span> { pluralize(c.CommitsCount, "commit", "commits") }
				</a>
			} else {
				<span class="shrink-0 whitespace-nowrap text-sm text-zinc-500">{ strconv.FormatInt(c.CommitsCount, 10) } { pluralize(c.CommitsCount, "commit", "commits") }</span>
			}
		}
	</div>
}

// fileList is the landing's root listing: the "latest commit" bar as its header, then one row
// per entry. An entry opens the browser in place of the landing (#content); a commit opens in
// the landing's region (#repo-main).
templ fileList(v RepoView) {
	@panel() {
		@latestCommitBar(v.Latest, "#repo-main")
		<div class="divide-y divide-zinc-800/70">
			for _, e := range v.Entries {
				@entryRow(e, "#content", swapNav, "#repo-main")
			}
		</div>
	}
}

// latestCommitBar is a listing panel's header: the latest commit that changed the directory,
// its message a link to the commit, which swaps commitTarget.
templ latestCommitBar(lc LatestCommit, commitTarget string) {
	@panelHead() {
		if lc.Present {
			<span class="shrink-0 text-zinc-300">{ lc.Author }</span>
			if lc.Href != "" {
				<a href={ templ.SafeURL(lc.Href) } hx-get={ lc.Href } hx-target={ commitTarget } hx-swap={ swapNav } hx-push-url="true" class="min-w-0 flex-1 truncate font-normal text-zinc-500 transition-colors hover:text-zinc-300">{ lc.Message }</a>
			} else {
				<span class="min-w-0 flex-1 truncate font-normal text-zinc-500">{ lc.Message }</span>
			}
			<span class="shrink-0 whitespace-nowrap font-normal text-zinc-600" title={ lc.AgeTitle }>{ lc.Age }</span>
		} else {
			<span class="font-normal text-zinc-500">No commits yet</span>
		}
	}
}

// entryRow is one tree entry. The whole row is NOT a single anchor (that would nest the commit
// link inside it) — the name and the commit message are separate links within a hover row. The
// name swaps target (with swap, the swap spec), the commit message commitTarget.
templ entryRow(e EntryItem, target, swap, commitTarget string) {
	<div class="flex items-center gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-zinc-900/40">
		if e.IsLink {
			<span class="shrink-0 text-zinc-400">
				@iconSymlink()
			</span>
		} else if e.IsDir {
			<span class="shrink-0 text-sky-400/80">
				@iconFolder()
			</span>
		} else {
			<span class="shrink-0 text-zinc-500">
				@iconFile()
			</span>
		}
		if e.Href != "" {
			<a href={ templ.SafeURL(e.Href) } hx-get={ e.Href } hx-target={ target } hx-swap={ swap } hx-push-url="true" class={ "truncate", templ.KV("font-medium text-zinc-100", e.IsDir), templ.KV("text-zinc-300", !e.IsDir) }>{ e.Name }</a>
		} else {
			<span class={ "truncate", templ.KV("font-medium text-zinc-100", e.IsDir), templ.KV("text-zinc-300", !e.IsDir) }>{ e.Name }</span>
		}
		<span class="min-w-0 flex-1"></span>
		if e.CommitMsg != "" {
			if e.CommitHref != "" {
				<a href={ templ.SafeURL(e.CommitHref) } hx-get={ e.CommitHref } hx-target={ commitTarget } hx-swap={ swapNav } hx-push-url="true" class="hidden max-w-[45%] truncate text-sm text-zinc-500 transition-colors hover:text-zinc-300 hover:underline md:block">{ e.CommitMsg }</a>
			} else {
				<span class="hidden max-w-[45%] truncate text-sm text-zinc-500 md:block">{ e.CommitMsg }</span>
			}
		}
		if e.Age != "" {
			<span class="shrink-0 whitespace-nowrap text-sm text-zinc-600" title={ e.AgeTitle }>{ e.Age }</span>
		}
	</div>
}

// readmeCard renders the discovered README below the file list: a filename header bar and the
// server-rendered, sanitized markup body (styled by the `.markup` prose rules in input.css).
templ readmeCard(r ReadmeView) {
	<div class="mt-6">
		@panel() {
			@panelHead() {
				<span class="text-zinc-500">
					@iconBook()
				</span>
				<h3>{ r.Name }</h3>
			}
			<div class="markup px-6 py-6 sm:px-8">
				@templ.Raw(r.HTML)
			</div>
		}
	</div>
}

// fileCard renders one file's content, in the browser's pane, in the mode the backend chose.
// Blame opens in the pane; History, a page of its own, in place of the browser.
templ fileCard(f FileBlob) {
	@panel() {
		@panelHead() {
			<span class="whitespace-nowrap">{ f.SizeHuman }</span>
			if f.LexerName != "" {
				<span class="text-zinc-600">·</span>
				<span class="min-w-0 truncate">{ f.LexerName }</span>
			}
			<span class="flex-1"></span>
			if f.HistoryHref != "" {
				<a href={ templ.SafeURL(f.HistoryHref) } hx-get={ f.HistoryHref } hx-target="#content" hx-swap={ swapNav } hx-push-url="true" class="shrink-0 transition-colors hover:text-zinc-200">History</a>
			}
			if f.BlameHref != "" {
				<a href={ templ.SafeURL(f.BlameHref) } hx-get={ f.BlameHref } hx-target="#browse-main" hx-swap={ swapPane } hx-push-url="true" class="shrink-0 transition-colors hover:text-zinc-200">Blame</a>
			}
			if f.RawHref != "" {
				<a href={ templ.SafeURL(f.RawHref) } class="shrink-0 transition-colors hover:text-zinc-200">Raw</a>
			}
		}
		switch f.Mode {
			case "markup":
				<div class="markup px-6 py-6 sm:px-8">
					@templ.Raw(f.HTML)
				</div>
			case "source":
				@sourceView(f)
			case "image":
				<div class="flex justify-center bg-zinc-950 p-6">
					<img src={ f.ImageSrc } alt={ f.Name } class="max-w-full"/>
				</div>
			default:
				@panelEmpty() {
					This file can't be displayed here.
					if f.RawHref != "" {
						<a href={ templ.SafeURL(f.RawHref) } class="text-zinc-300 underline decoration-zinc-700 underline-offset-2 hover:decoration-zinc-400">Download</a>
					}
				}
		}
	}
}

// sourceView is a line-numbered, syntax-highlighted code table. Each line is server-highlighted
// (chroma) HTML; the `.chroma` scope on the table resolves the token color classes.
templ sourceView(f FileBlob) {
	<div class="chroma overflow-x-auto">
		<table class="w-full border-collapse font-mono text-[12.5px] leading-[1.6]">
			<tbody>
				for i, line := range f.Lines {
					<tr class="transition-colors hover:bg-zinc-900/40">
						<td class="w-[1%] select-none whitespace-nowrap px-4 text-right align-top text-zinc-600">
							<a href={ templ.SafeURL("#L" + strconv.Itoa(i+1)) } id={ "L" + strconv.Itoa(i+1) } class="text-zinc-600 hover:text-zinc-300">{ strconv.Itoa(i + 1) }</a>
						</td>
						<td class="w-full whitespace-pre px-4 align-top text-zinc-200">
							@templ.Raw(string(line))
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// emptyRepo is the quick-start state for a repository whose main has nothing on it yet: how to
// clone it with ok's jj, make a first change, and upload it as a changelist.
templ emptyRepo(c RepoChrome) {
	@panel() {
		@panelTitle("Quick Setup")
		@panelBody() {
			<p class="text-sm text-zinc-500">Nothing has landed on main yet. Clone the repository with ok's jj, make a change, and upload it for review; it lands on main when it is submitted.</p>
			@cloneRow("Clone", c.Clone.Command)
			<div class="mt-6 text-sm font-medium text-zinc-400">A First Change</div>
			<pre class="mt-2 overflow-x-auto rounded-lg border border-zinc-800 bg-zinc-950 px-4 py-3 font-mono text-sm leading-relaxed text-zinc-300">{ c.Clone.Command + "\ncd " + c.Name + "\n# make a change, then describe it and upload it:\njj describe -m 'the first change'\njj cl --ready" }</pre>
		}
	}
}

// changesLink is the repo-header "Changes" button → the ChangeList (CL) finder: an htmx swap of
// target — the landing's #repo-main (the header + rail stay put), or #content from the browser,
// whose layout the finder does not share.
templ changesLink(href, target string) {
	if href != "" {
		<a href={ templ.SafeURL(href) } hx-get={ href } hx-target={ target } hx-swap={ swapNav } hx-push-url="true" class={ btnClass(btnSecondary) }>
			<span class="text-zinc-500">
				@iconChanges()
			</span>
			Changes
		</a>
	}
}

templ iconChanges() {
	<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.5 3.25a2.25 2.25 0 1 1 3 2.122v5.256a2.251 2.251 0 1 1-1.5 0V5.372A2.25 2.25 0 0 1 1.5 3.25Zm5.677-.177L9.573.677A.25.25 0 0 1 10 .854V2.5h1A2.5 2.5 0 0 1 13.5 5v5.628a2.251 2.251 0 1 1-1.5 0V5a1 1 0 0 0-1-1h-1v1.646a.25.25 0 0 1-.427.177L7.177 3.427a.25.25 0 0 1 0-.354ZM3.75 2.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm0 9.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5Zm8.25.75a.75.75 0 1 0 1.5 0 .75.75 0 0 0-1.5 0Z"></path></svg>
}

// codeButton is the "Code" clone popover — a native <details> disclosure (no JS): the jj clone
// command with a copy button (the clipboard component). ok's jj is the only client.
templ codeButton(c CloneURLs) {
	<details class="group/code relative">
		<summary class={ btnClass(btnInverse), "list-none [&::-webkit-details-marker]:hidden" }>
			<span class="text-zinc-700">
				@iconCode()
			</span>
			Code
			<span class="text-zinc-500 transition-transform group-open/code:rotate-180">
				@iconChevron()
			</span>
		</summary>
		<div class="absolute right-0 z-20 mt-2 w-80 rounded-xl border border-zinc-800 bg-zinc-950 p-4 shadow-xl shadow-black/50">
			<div class="text-sm font-medium text-zinc-400">Clone</div>
			@cloneRow("With ok's jj", c.Command)
		</div>
	</details>
}

// cloneRow is one labelled, read-only clone command with a copy button.
templ cloneRow(label, url string) {
	<div class="mt-3">
		<div class="mb-1 text-sm text-zinc-400">{ label }</div>
		<div class="flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900/60 px-2.5 py-1.5">
			<input readonly value={ url } class="min-w-0 flex-1 bg-transparent font-mono text-sm text-zinc-200 focus:outline-none"/>
			@clipboard.Button(url, "shrink-0 rounded-md p-1.5 text-zinc-400 transition-colors hover:bg-zinc-800 hover:text-zinc-100") {
				<span data-copy-idle>
					@iconCopy()
				</span>
				<span data-copy-done class="hidden text-emerald-400">
					@iconCheck()
				</span>
			}
		</div>
	</div>
}

// atChip names the commit being browsed: main's head, or an older commit with a link back to
// main, which swaps target.
templ atChip(at CommitAt, target string) {
	if at.Short == "" {
		<span class="flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900/60 px-3 py-1.5 text-sm font-medium text-zinc-200">
			<span class="text-zinc-500">
				@iconHistory()
			</span>
			main
		</span>
	} else {
		<span class="flex items-center gap-2 rounded-lg border border-zinc-800 bg-zinc-900/60 px-3 py-1.5 text-sm text-zinc-300">
			<span class="text-zinc-500">
				@iconHistory()
			</span>
			<span class="font-mono">{ at.Short }</span>
			if at.MainHref != "" {
				<a href={ templ.SafeURL(at.MainHref) } hx-get={ at.MainHref } hx-target={ target } hx-swap={ swapNav } hx-push-url="true" class="text-zinc-500 transition-colors hover:text-zinc-200">Back to main</a>
			}
		</span>
	}
}

// --- Commit history ------------------------------------------------------------------------

// CommitsPage / CommitsContent render main's history: the shared header + Code popover, the
// commit rows (optionally only those touching a path), and a pager.
templ CommitsPage(n nav.Model, v CommitsView) {
	@layout.Shell(shell("Commits · "+v.Chrome.Name+" · "+Brand, layout.LeftNav, n)) {
		@CommitsContent(v)
	}
}

templ CommitsContent(v CommitsView) {
	<div class="flex h-full flex-1 flex-col overflow-hidden">
		<div class="shrink-0">
			@PageHead(v.Chrome.Name, v.Chrome.Subtitle, "") {
				@changesLink(v.Chrome.ChangesHref, "#repo-main")
				@codeButton(v.Chrome.Clone)
			}
		</div>
		<div id="repo-main" data-hydrate class="hydrating flex-1 overflow-y-auto">
			@CommitsMain(v)
		</div>
	</div>
}

// CommitsMain is the swappable in-repo region for the commit history — the commit rows and
// the pager. Swapped as #repo-main; ServeCommits returns it alone on an
// HX-Target=repo-main request.
templ CommitsMain(v CommitsView) {
	<div class="mx-auto w-full max-w-5xl px-6 pb-16 sm:px-10">
		@panel() {
			@panelHead() {
				<h3>Commits on Main</h3>
				if v.FilePath != "" {
					<span class="text-zinc-600">·</span>
					<span class="min-w-0 truncate font-mono font-normal text-zinc-400">{ v.FilePath }</span>
				}
				<span class="flex-1"></span>
				if v.Count > 0 {
					<span class="shrink-0 whitespace-nowrap font-normal text-zinc-500"><span class="font-medium text-zinc-300">{ strconv.FormatInt(v.Count, 10) }</span> { pluralize(v.Count, "commit", "commits") }</span>
				}
			}
			if len(v.Commits) == 0 {
				@panelEmpty() {
					No commits found.
				}
			} else {
				<div class="divide-y divide-zinc-800/70">
					for _, c := range v.Commits {
						@commitRow(c)
					}
				</div>
			}
		}
		if len(v.Commits) > 0 {
			@commitPager(v)
		}
	</div>
}

// commitRow is one commit in the history: the subject (linked to its diff), author + age + the
// CL it landed from, and a trailing control cluster — the short commit ID (→ diff), a copy
// button, and a "browse the tree at this commit" link.
templ commitRow(c CommitRow) {
	<div class="flex items-center gap-3 px-4 py-3 text-sm transition-colors hover:bg-zinc-900/40">
		<div class="min-w-0 flex-1">
			<a href={ templ.SafeURL(c.Href) } hx-get={ c.Href } hx-target="#repo-main" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class="block truncate font-medium text-zinc-100 transition-colors hover:text-white hover:underline">{ c.Title }</a>
			<div class="mt-0.5 flex flex-wrap items-center gap-2 text-sm text-zinc-500">
				<span class="font-medium text-zinc-400">{ c.Author }</span>
				<span class="text-zinc-600">·</span>
				<span title={ c.AgeTitle }>{ c.Age }</span>
				if c.CLHref != "" {
					<a href={ templ.SafeURL(c.CLHref) } hx-get={ c.CLHref } hx-target="#repo-main" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class={ chipClass(toneNeutral), "transition-colors hover:text-zinc-100" }>CL { strconv.FormatInt(c.CL, 10) }</a>
				}
			</div>
		</div>
		<div class="flex shrink-0 items-center gap-1">
			<a href={ templ.SafeURL(c.Href) } hx-get={ c.Href } hx-target="#repo-main" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class="rounded-md border border-zinc-800 bg-zinc-900/60 px-2 py-1 font-mono text-sm text-zinc-300 transition-colors hover:bg-zinc-800 hover:text-zinc-100">{ c.ShortSHA }</a>
			@clipboard.Button(c.SHA, "rounded-md p-1.5 text-zinc-500 transition-colors hover:bg-zinc-800 hover:text-zinc-200") {
				<span data-copy-idle>
					@iconCopy()
				</span>
				<span data-copy-done class="hidden text-emerald-400">
					@iconCheck()
				</span>
			}
			<a href={ templ.SafeURL(c.BrowseHref) } hx-get={ c.BrowseHref } hx-target="#repo-main" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" title="Browse the repository at this commit" class="rounded-md p-1.5 text-zinc-500 transition-colors hover:bg-zinc-800 hover:text-zinc-200">
				@iconCode()
			</a>
		</div>
	</div>
}

// commitPager is the newer/older pair for the commit history (only rendered when a neighbour page
// exists; the unavailable direction is a dimmed, non-interactive label).
templ commitPager(v CommitsView) {
	if v.PrevHref != "" || v.NextHref != "" {
		<div class="mt-4 flex items-center justify-between">
			if v.PrevHref != "" {
				<a href={ templ.SafeURL(v.PrevHref) } hx-get={ v.PrevHref } hx-target="#repo-main" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class="rounded-lg border border-zinc-800 bg-zinc-900/60 px-3 py-1.5 text-sm text-zinc-300 transition-colors hover:bg-zinc-900">Newer</a>
			} else {
				<span class="rounded-lg border border-zinc-900 px-3 py-1.5 text-sm text-zinc-700">Newer</span>
			}
			if v.NextHref != "" {
				<a href={ templ.SafeURL(v.NextHref) } hx-get={ v.NextHref } hx-target="#repo-main" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class="rounded-lg border border-zinc-800 bg-zinc-900/60 px-3 py-1.5 text-sm text-zinc-300 transition-colors hover:bg-zinc-900">Older</a>
			} else {
				<span class="rounded-lg border border-zinc-900 px-3 py-1.5 text-sm text-zinc-700">Older</span>
			}
		</div>
	}
}

// --- Single-commit diff --------------------------------------------------------------------

// CommitDiffPage / CommitDiffContent render one commit: the shared header + Code popover, the
// commit message + metadata card, a changed-files stat bar, and one card per changed file.
templ CommitDiffPage(n nav.Model, v CommitDiffView) {
	@layout.Shell(shell(v.ShortSHA+" · "+v.Chrome.Name+" · "+Brand, layout.LeftNav, n)) {
		@CommitDiffContent(v)
	}
}

templ CommitDiffContent(v CommitDiffView) {
	<div class="flex h-full flex-1 flex-col overflow-hidden">
		<div class="shrink-0">
			@PageHead(v.Chrome.Name, v.Chrome.Subtitle, "") {
				@changesLink(v.Chrome.ChangesHref, "#repo-main")
				@codeButton(v.Chrome.Clone)
			}
		</div>
		<div id="repo-main" data-hydrate class="hydrating flex-1 overflow-y-auto">
			@CommitDiffMain(v)
		</div>
	</div>
}

// CommitDiffMain is the swappable in-repo region for one commit — the message/metadata card, the
// stat bar, and the per-file diffs. Swapped as #repo-main; ServeCommitDiff returns it alone on an
// HX-Target=repo-main request.
templ CommitDiffMain(v CommitDiffView) {
	<div class="mx-auto w-full max-w-5xl px-6 pb-16 sm:px-10">
		@commitHeader(v)
		@diffStatBar(v)
		@panel() {
			@fileTableHead()
			if len(v.Files) == 0 {
				@panelEmpty() {
					No file changes.
				}
			} else {
				@FileRows(v.Files, v.MoreFilesHref)
			}
		}
	</div>
}

// commitHeader is the commit's identity, mirroring the CL view: the subject as the page title, then
// a Commit Message panel whose header carries the author + age, the CL it landed from, the parent
// link(s), the change ID, and the commit ID with a copy button.
templ commitHeader(v CommitDiffView) {
	<h2 class="mb-4 text-xl font-semibold tracking-tight text-zinc-50">{ v.Title }</h2>
	<div class="mb-4">
		@panel() {
			@panelHead() {
				<span class="text-zinc-300">{ v.Author }</span>
				<span class="font-normal text-zinc-500" title={ v.AgeTitle }>committed { v.Age }</span>
				if v.CLHref != "" {
					<a href={ templ.SafeURL(v.CLHref) } hx-get={ v.CLHref } hx-target="#repo-main" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class={ chipClass(toneNeutral), "transition-colors hover:text-zinc-100" }>CL { strconv.FormatInt(v.CL, 10) }</a>
				}
				<span class="flex-1"></span>
				if len(v.Parents) > 0 {
					<span class="font-normal text-zinc-600">Parent</span>
					for _, p := range v.Parents {
						<a href={ templ.SafeURL(p.Href) } hx-get={ p.Href } hx-target="#repo-main" hx-swap="innerHTML swap:70ms settle:1ms" hx-push-url="true" class={ chipClass(toneNeutral), "font-mono transition-colors hover:text-zinc-100" }>{ p.ShortSHA }</a>
					}
				}
				<span class={ chipClass(toneNeutral), "font-mono" } title="Change ID">{ v.ChangeID }</span>
				<span class={ chipClass(toneNeutral), "font-mono" } title="Commit ID">{ v.ShortSHA }</span>
				@clipboard.Button(v.SHA, "rounded-md p-1 text-zinc-500 transition-colors hover:bg-zinc-800 hover:text-zinc-200") {
					<span data-copy-idle>
						@iconCopy()
					</span>
					<span data-copy-done class="hidden text-emerald-400">
						@iconCheck()
					</span>
				}
			}
			<pre class="whitespace-pre-wrap px-4 py-3 font-mono text-sm leading-relaxed text-zinc-300">{ clFullMessage(v.Title, v.Body) }</pre>
		}
	</div>
}

// diffStatBar is the "N files changed, +X −Y" summary line above the file list.
templ diffStatBar(v CommitDiffView) {
	<div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-zinc-500">
		<span><span class="font-medium text-zinc-300">{ strconv.Itoa(v.NumFiles) }</span> { pluralize(int64(v.NumFiles), "file", "files") } changed</span>
		if v.TotalsKnown {
			<span class="text-emerald-400">+{ strconv.Itoa(v.Addition) }</span>
			<span class="text-red-400">−{ strconv.Itoa(v.Deletion) }</span>
		}
	</div>
}

// fileTableHead is a file list's column labels.
templ fileTableHead() {
	@panelHead() {
		<span class="w-24 shrink-0">Status</span>
		<span class="flex-1">File</span>
		<span class="shrink-0">Delta</span>
		<span class="w-4 shrink-0"></span>
	}
}

// FileRows is a page of a file list's rows — a CL's or a commit's — and, when there are more,
// the loader that fetches the next page as it scrolls into view.
templ FileRows(rows []DiffFileView, next string) {
	for _, f := range rows {
		@fileRow(f)
	}
	if next != "" {
		<div data-live hx-get={ next } hx-trigger="intersect once" hx-swap="outerHTML" class="px-4 py-2.5 text-sm text-zinc-500">Loading more files…</div>
	}
}

// fileRow is one changed file: its status, path, review threads, and ±counts, and — once
// opened — its diff, which it loads then (a row that starts open loads it as it scrolls into
// view).
templ fileRow(f DiffFileView) {
	<details id={ f.Anchor } class="group border-b border-zinc-800/70 last:border-b-0" open?={ f.Open }>
		<summary class="flex cursor-pointer list-none items-center gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-zinc-900/40 [&::-webkit-details-marker]:hidden">
			<span class="w-24 shrink-0">
				@diffStatusPill(f.Status)
			</span>
			<span class="flex min-w-0 flex-1 items-center gap-2 font-mono">
				if f.OldName != "" && f.OldName != f.Name {
					<span class="min-w-0 truncate text-zinc-500">{ f.OldName }</span>
					<span class="shrink-0 text-zinc-600">→</span>
				}
				<span class="min-w-0 truncate text-zinc-200">{ f.Name }</span>
			</span>
			if f.ThreadCount > 0 {
				<span title="review comments">
					@chip(toneInfo) {
						{ pluralCount(f.ThreadCount, "Comment", "Comments") }
					}
				</span>
			}
			if f.OffDiff {
				<span class="shrink-0 text-zinc-600">—</span>
			} else if !f.IsBinary {
				<span class="shrink-0 whitespace-nowrap"><span class="text-emerald-400">+{ strconv.Itoa(f.Addition) }</span> <span class="text-red-400">−{ strconv.Itoa(f.Deletion) }</span></span>
			}
			<span class="flex w-4 shrink-0 justify-center text-zinc-600 transition-transform group-open:rotate-180">
				@iconChevron()
			</span>
		</summary>
		<div class="border-t border-zinc-800/70">
			<div data-live hx-get={ f.BodyHref } hx-trigger="intersect once" hx-swap="outerHTML" class="px-4 py-3 text-sm text-zinc-500">Loading the diff…</div>
		</div>
	</details>
}

// FileBody is a commit's file's diff, which its row loads when opened.
templ FileBody(f DiffFileView) {
	<div data-live>
		@diffFileBody(f)
	</div>
}

// diffFileBody is one file's diff content (binary/too-large/generated placeholder, or the
// line-numbered diff table). Split out of diffFile so the CL file table can embed it under an
// expandable row.
templ diffFileBody(f DiffFileView) {
	if f.IsBinary {
		@panelEmpty() {
			Binary file not shown.
		}
	} else if f.TooLarge {
		@panelEmpty() {
			This file's diff is too large to display.
		}
	} else if f.Collapsed {
		@panelEmpty() {
			This file is generated or vendored and is hidden by default.
		}
	} else if len(f.Sections) == 0 {
		@panelEmpty() {
			No changes.
		}
	} else {
		<div class="chroma overflow-x-auto">
			<table class="w-full border-collapse font-mono text-[12.5px] leading-[1.6]">
				<tbody>
					for _, sec := range f.Sections {
						for _, ln := range sec {
							@diffLine(ln)
						}
					}
				</tbody>
			</table>
		</div>
	}
}

// diffLine is one row of a file diff: a hunk header spanning the row, or a two-gutter (old/new
// line number) code line coloured by change type. Content is server-highlighted HTML.
templ diffLine(ln DiffLineRow) {
	if ln.Type == "tag" {
		<tr class="select-none bg-zinc-900/60 text-zinc-500">
			<td colspan="3" class="px-3 py-1">
				@templ.Raw(ln.Content)
			</td>
		</tr>
	} else {
		<tr class={ diffRowClass(ln.Type) }>
			<td class="w-[1%] select-none whitespace-nowrap px-2 text-right align-top text-zinc-600">{ lineNo(ln.LeftIdx) }</td>
			<td class="w-[1%] select-none whitespace-nowrap px-2 text-right align-top text-zinc-600">{ lineNo(ln.RightIdx) }</td>
			<td class="w-full whitespace-pre-wrap break-all py-px pl-2 pr-3 align-top text-zinc-200">
				<span class="mr-1 select-none text-zinc-500">{ diffMarker(ln.Type) }</span>@templ.Raw(ln.Content)
			</td>
		</tr>
	}
}

// diffStatusPill is a changed file's status chip (Added / Modified / Deleted / Renamed / Copied).
templ diffStatusPill(status string) {
	@chip(diffStatusTone(status)) {
		{ diffStatusLabel(status) }
	}
}

// --- Blame -------------------------------------------------------------------------------

// blameLine is one line of a blame: at the start of each run of lines one commit changed, that
// commit (its short ID, author, and age, titled with its subject); then the line number and the
// highlighted line.
templ blameLine(l BlameLine) {
	<tr class={ "transition-colors hover:bg-zinc-900/40", templ.KV("border-t border-zinc-800/70", l.First && l.Number > 1) }>
		<td class="w-[1%] max-w-[18rem] whitespace-nowrap px-3 align-top font-sans text-sm" title={ l.CommitTitle }>
			if l.First {
				if l.CommitHref != "" {
					<a href={ templ.SafeURL(l.CommitHref) } hx-get={ l.CommitHref } hx-target="#content" hx-swap={ swapNav } hx-push-url="true" class="font-mono text-zinc-400 transition-colors hover:text-zinc-100">{ l.CommitShort }</a>
				}
				<span class="ml-2 text-zinc-500">{ l.Author }</span>
				<span class="ml-2 text-zinc-600" title={ l.AgeTitle }>{ l.Age }</span>
			}
		</td>
		<td class="w-[1%] select-none whitespace-nowrap px-3 text-right align-top text-zinc-600">
			<a href={ templ.SafeURL("#L" + strconv.Itoa(l.Number)) } id={ "L" + strconv.Itoa(l.Number) } class="text-zinc-600 hover:text-zinc-300">{ strconv.Itoa(l.Number) }</a>
		</td>
		<td class="w-full whitespace-pre px-3 align-top text-zinc-200">
			@templ.Raw(l.HTML)
		</td>
	</tr>
}

// --- Inline octicon glyphs (these pages' own; nav.templ's icon set is for the nav rail only) ---
templ iconFolder() {
	<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1.75 1A1.75 1.75 0 0 0 0 2.75v10.5C0 14.216.784 15 1.75 15h12.5A1.75 1.75 0 0 0 16 13.25v-8.5A1.75 1.75 0 0 0 14.25 3H7.5a.25.25 0 0 1-.2-.1l-.9-1.2C6.07 1.26 5.55 1 5 1H1.75Z"></path></svg>
}

