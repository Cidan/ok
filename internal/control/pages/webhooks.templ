package pages

import (
	"github.com/Cidan/ok/internal/web/layout"
	"github.com/Cidan/ok/internal/web/nav"
)

// WebhooksPage is a repository's webhooks (docs/hosted.md, "ok control at scale, as built"): its
// administrators' to add and remove, each with its latest deliveries. It is the repository
// header's Webhooks tab; WebhooksContent is the swappable region, and WebhooksMain what the tab
// swaps into #repo-main.
templ WebhooksPage(n nav.Model, v WebhooksView) {
	@layout.Shell(shell("Webhooks · "+v.Chrome.Name+" · "+Brand, layout.TopNav, n)) {
		@WebhooksContent(v)
	}
}

templ WebhooksContent(v WebhooksView) {
	<div class="group/repo flex h-full flex-1 flex-col overflow-hidden">
		@repoHead(v.Chrome, tabWebhooks, "#repo-main", false)
		<div id="repo-main" data-hydrate class="hydrating flex-1 overflow-y-auto">
			@WebhooksMain(v)
		</div>
	</div>
}

// WebhooksMain is how a webhook is signed, the secret of one just made, each webhook with its
// latest deliveries, and the form that adds one.
templ WebhooksMain(v WebhooksView) {
	<div class="mx-auto w-full max-w-5xl space-y-5 px-6 pt-6 pb-16 sm:px-10">
		<div>
			<h2 class="text-xl font-semibold tracking-tight text-fg">Webhooks</h2>
			<p class="mt-1.5 text-sm text-muted">ok POSTs each event a webhook wants to it, signed with its secret: <span class="font-mono text-body">X-Ok-Signature-256</span>, HMAC-SHA256 of the body.</p>
		</div>
		if !v.Enabled {
			<div class="flex items-start gap-2.5 rounded-xl border border-line bg-neutral-soft px-4 py-3 text-sm text-muted">
				<span class="mt-px text-accent-fg">
					@iconInfo()
				</span>
				<span>This installation keeps no webhooks: its administrators name a sealing key (<span class="font-mono text-body">control.sealing_key_file</span>).</span>
			</div>
		} else {
			if v.Error != "" {
				<div class="flex items-start gap-2.5 rounded-xl border border-danger-line bg-danger-soft px-4 py-3 text-sm text-danger">
					@iconAlert()
					<span>{ v.Error }</span>
				</div>
			}
			if v.Created != nil {
				<div id="webhook-secret" class="rounded-xl border border-warn-line bg-warn-soft px-4 py-3 text-sm text-warn">
					<div>Its secret, shown this once — keep it where the endpoint checks signatures:</div>
					<div class="mt-2 select-all break-all rounded-lg border border-warn-line bg-sunken px-3 py-2 font-mono text-fg">{ v.Created.Secret }</div>
				</div>
			}
			if len(v.Hooks) == 0 {
				@panel() {
					@panelTitle("Webhooks")
					@panelEmpty() {
						No webhooks yet: add one below.
					}
				}
			}
			for _, w := range v.Hooks {
				<section data-webhook class="overflow-hidden rounded-2xl border border-line bg-surface shadow-panel">
					<div class="flex min-h-12 items-center gap-3 border-b border-line px-4 py-2">
						<span class="text-accent-fg">
							@iconWebhook()
						</span>
						<div class="min-w-0 flex-1">
							<div class="truncate font-mono text-sm text-fg">{ w.URL }</div>
							<div class="mt-0.5 truncate text-xs text-subtle">{ w.Events } · added by { w.CreatedBy } { w.Ago }</div>
						</div>
						<form method="post" action={ templ.SafeURL(w.DeleteHref) }>
							<button type="submit" class={ btnClass(btnSecondary) }>
								@iconTrash()
								Remove
							</button>
						</form>
					</div>
					if len(w.Deliveries) == 0 {
						@panelEmpty() {
							No deliveries yet.
						}
					}
					<div class="divide-y divide-line-soft">
						for _, d := range w.Deliveries {
							<div data-delivery data-state={ d.State } class="flex items-center gap-3 px-4 py-2.5 text-sm">
								<span class="w-24 shrink-0">
									@chip(deliveryTone(d.State)) {
										{ deliveryLabel(d.State) }
									}
								</span>
								<span class="w-14 shrink-0 font-mono text-muted">{ d.Event }</span>
								<span class="min-w-0 flex-1 truncate text-subtle">{ d.Detail }</span>
								<span class="shrink-0 text-xs whitespace-nowrap text-faint">{ d.Ago }</span>
								<form method="post" action={ templ.SafeURL(d.RedeliverHref) }>
									<button type="submit" class="cursor-pointer rounded-md px-1.5 py-0.5 text-sm text-accent-fg transition-colors hover:bg-accent-soft">Redeliver</button>
								</form>
							</div>
						}
					</div>
				</section>
			}
			@panel() {
				@panelTitle("Add a Webhook")
				<form method="post" action={ templ.SafeURL(v.CreateHref) } class="space-y-4 px-4 py-4">
					<div>
						<label for="webhook-url" class="mb-2 block text-sm font-medium text-muted">Payload URL</label>
						<input id="webhook-url" name="url" type="url" required placeholder="https://example.com/ok" autocomplete="off" spellcheck="false" class={ inputClass, "font-mono" }/>
					</div>
					<div class="flex flex-wrap gap-5 text-sm text-body">
						<label class="flex cursor-pointer items-center gap-2"><input type="checkbox" name="event" value="cl" checked class="accent-accent"/> CL Events and Comments</label>
						<label class="flex cursor-pointer items-center gap-2"><input type="checkbox" name="event" value="push" class="accent-accent"/> Main Moved</label>
					</div>
					<div class="border-t border-line-soft pt-4">
						<button type="submit" class={ btnClass(btnPrimary) }>Add Webhook</button>
					</div>
				</form>
			}
		}
	</div>
}
